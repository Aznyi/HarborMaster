# Build output. These are anchored to the repository root on purpose: an
# unanchored `harbormaster` pattern would also match the cmd/harbormaster
# package directory and silently exclude the entrypoint from the repository.
/bin/
/dist/
/harbormaster
/harbormaster.exe

# Embedded frontend build output (generated by `make web-build`)
/web/dist/*
!/web/dist/.gitkeep

# Node
node_modules/
.npm/
*.tsbuildinfo
vite.config.*.timestamp-*

# Go
*.test
*.out
coverage.txt

# Local runtime data (SQLite database and WAL/SHM sidecars)
/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Environment / secrets. `.env.example` is intentionally tracked.
.env
.env.*
!.env.example

# Local agent instructions (not part of the published repository)
/CLAUDE.md
/CLAUDE.local.md

# Working notes only.
#
# HarborMaster is open source: contributors and operators are meant to receive
# the security documentation, the threat model, the architecture notes, and the
# engineering standards. What they are NOT meant to receive is development
# scratch work -- implementation plans, design iterations, and drafts, which are
# useful while building a phase and misleading afterwards.
#
# So the ignore is scoped to the scratch directories, not to docs/ as a whole.
/docs/design/
/docs/plans/
/docs/tmp/
/docs/drafts/

# GitHub Wiki staging.
#
# The wiki lives in its own repository (HarborMaster.wiki.git). This directory
# is where its pages are written and reviewed before being pushed there, and it
# is deliberately NOT part of this repository: two copies of the same page, one
# here and one in the wiki, is how they start disagreeing -- and the one people
# read is the wiki.
/docs/wiki/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Scan reports. Running the Gitleaks command from the security workflow by hand
# writes results.sarif into the working tree; it is an artifact of a run, not
# part of the repository.
results.sarif
*.sarif
