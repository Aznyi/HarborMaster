# HarborMaster configuration.
#
# Copy to `.env` and adjust. Every value below is a DEFAULT, not a secret --
# HarborMaster never logs environment-variable values, and no credential is
# read from this file today.

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------

# Listen address. Defaults to loopback so a bare binary is never exposed to the
# network by accident. The container image overrides this to 0.0.0.0:8080
# because it is already isolated by the container network namespace.
HARBORMASTER_HTTP_ADDR=127.0.0.1:8080

# Maximum accepted request body, in bytes. Requests above this are rejected
# with 413 before any handler runs.
HARBORMASTER_MAX_REQUEST_BYTES=1048576

# Server timeouts (Go duration syntax: 15s, 1m, 500ms).
HARBORMASTER_READ_HEADER_TIMEOUT=5s
HARBORMASTER_READ_TIMEOUT=15s
HARBORMASTER_WRITE_TIMEOUT=30s
HARBORMASTER_IDLE_TIMEOUT=60s

# Grace period for in-flight requests after SIGINT/SIGTERM.
HARBORMASTER_SHUTDOWN_TIMEOUT=15s

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------

# Docker Engine endpoint. Treat this socket as a privileged interface: anything
# that can talk to it can control the host's containers. Mount it read-only.
# Windows hosts: npipe:////./pipe/docker_engine
HARBORMASTER_DOCKER_HOST=unix:///var/run/docker.sock

# Per-call timeout for Docker Engine requests.
HARBORMASTER_DOCKER_TIMEOUT=10s

# ---------------------------------------------------------------------------
# Inventory
# ---------------------------------------------------------------------------

# Turn the read-only inventory engine on or off. When false, no refresh runs
# and the API serves whatever was last stored.
HARBORMASTER_INVENTORY_ENABLED=true

# Collect an inventory once as soon as the server is up.
HARBORMASTER_INVENTORY_REFRESH_ON_STARTUP=true

# Periodic refresh interval. Set to 0 to disable periodic refresh and drive it
# manually from the UI or POST /api/v1/inventory/refresh. Non-zero values below
# 5s are rejected: this reads a privileged socket, and hammering it is not a
# configuration anyone wants by accident.
#
# NOTE: this governs the periodic sweep only while the event engine is DISABLED.
# With the engine on, HARBORMASTER_EVENTS_RECONCILE_INTERVAL takes over and this
# ticker is suppressed, so there is never more than one full-refresh timer.
# Startup and manual refreshes are unaffected either way.
HARBORMASTER_INVENTORY_REFRESH_INTERVAL=60s

# Concurrent container inspections. The Docker socket is a single daemon, so
# more is not automatically faster; this bounds the load HarborMaster puts on
# it. Must be between 1 and 64.
HARBORMASTER_INVENTORY_WORKERS=8

# How long a container that has disappeared is kept in the inventory before
# being purged. Absent containers are retained rather than deleted so their
# history survives. Set to 0 to keep them forever.
HARBORMASTER_INVENTORY_ABSENT_RETENTION=168h

# Environment-variable and log-option NAME fragments treated as secret-bearing.
# Matching is case-insensitive and by substring, so AUTH also masks AUTHOR --
# over-masking is the intended bias.
#
# Setting this REPLACES the built-in list rather than extending it. To add a
# pattern, repeat the defaults and append yours.
HARBORMASTER_INVENTORY_MASK_PATTERNS=PASSWORD,PASSWD,SECRET,TOKEN,API_KEY,APIKEY,PRIVATE_KEY,CREDENTIAL,AUTH

# ---------------------------------------------------------------------------
# Docker event engine
# ---------------------------------------------------------------------------
# HarborMaster subscribes to the Docker daemon's event stream and uses events as
# HINTS that inventory may have changed. It never writes container state from an
# event: it re-inspects the resource through the same pipeline a full refresh
# uses. Docker inspection and HarborMaster's own records stay authoritative.

# Turn the event engine on or off. When false nothing subscribes, the SSE
# endpoint reports the feature disabled, and periodic inventory refresh carries
# the inventory alone. That is a supported mode, not a degraded one.
HARBORMASTER_EVENTS_ENABLED=true

# --- Reconnection -----------------------------------------------------------
# Backoff after a dropped stream: the delay starts at the initial value,
# multiplies after each consecutive failure, and is capped at the maximum.
# Jitter of 50-100% is applied on top, so several HarborMasters that lost the
# same daemon do not reconnect in lockstep. A connection that stays up for the
# maximum delay resets the backoff.
HARBORMASTER_EVENTS_RECONNECT_INITIAL_DELAY=1s
HARBORMASTER_EVENTS_RECONNECT_MAX_DELAY=60s
HARBORMASTER_EVENTS_RECONNECT_MULTIPLIER=2.0

# --- Processing -------------------------------------------------------------
# The in-process queue between the stream reader and the event processor. The
# reader never blocks on it: a full queue means the event is dropped, counted,
# and a full reconciliation is requested, because a blocked reader would stall
# the whole stream silently.
HARBORMASTER_EVENTS_BUFFER_SIZE=1024

# Events are persisted in batches: a `compose up` burst costs one commit rather
# than sixty. A partial batch waits at most the flush interval.
HARBORMASTER_EVENTS_BATCH_SIZE=64
HARBORMASTER_EVENTS_BATCH_FLUSH_INTERVAL=500ms

# How long an event fingerprint is remembered, so a duplicate delivery (common
# after a reconnect that overlapped) does not trigger duplicate refresh work. A
# genuinely repeated event at a different Docker timestamp has a different
# fingerprint and is NOT suppressed.
HARBORMASTER_EVENTS_DEDUP_WINDOW=10s

# One lifecycle transition emits a burst: `docker restart` produces kill, die,
# stop, start, and usually a health_status within a second. This window
# coalesces them into a single refresh per resource.
HARBORMASTER_EVENTS_REFRESH_DEBOUNCE=750ms

# --- Reconciliation ---------------------------------------------------------
# The periodic FULL inventory sweep, and the safety net for everything the event
# stream missed. Docker drops events while nothing is listening and replays
# nothing across a daemon restart, so this stays on even when events flow
# perfectly.
#
# IMPORTANT: exactly one component owns the periodic full sweep. While the event
# engine is enabled it owns it at THIS interval, and
# HARBORMASTER_INVENTORY_REFRESH_INTERVAL is suppressed. Disable the event
# engine and the inventory's own interval takes over again, unchanged. Two
# independent full-refresh timers would double the load on a privileged socket.
HARBORMASTER_EVENTS_RECONCILE_INTERVAL=15m

# --- Retention --------------------------------------------------------------
# Event history is observational and unbounded without these. Set either to 0 to
# disable that dimension; both 0 keeps everything forever. Pruning runs in
# bounded batches and touches ONLY the event table -- it can never remove
# current inventory.
HARBORMASTER_EVENTS_RETENTION_AGE=168h
HARBORMASTER_EVENTS_RETENTION_COUNT=50000
HARBORMASTER_EVENTS_PRUNE_INTERVAL=1h

# --- Live stream (Server-Sent Events) ---------------------------------------
# GET /api/v1/events/stream is UNAUTHENTICATED like the rest of the API, so it
# carries only already-redacted event data and no raw Docker payload.

# Concurrent SSE clients. Each costs a buffered channel and a held connection,
# so the cap is what stops anything able to reach the port from pinning both.
# Over the limit the endpoint returns 503 with Retry-After.
HARBORMASTER_EVENTS_STREAM_MAX_SUBSCRIBERS=16

# Per-subscriber queue. A client that stops reading has events dropped for it
# alone; it never blocks event processing for anyone else.
HARBORMASTER_EVENTS_STREAM_BUFFER_SIZE=128

# How many stored events a Last-Event-ID reconnect replays. A client that fell
# further behind gets a truncation notice and should reload the paginated
# history instead of expecting the stream to catch it up.
HARBORMASTER_EVENTS_STREAM_REPLAY_LIMIT=200

# Comment-frame interval that keeps an idle stream alive through proxies.
HARBORMASTER_EVENTS_STREAM_HEARTBEAT=20s

# ---------------------------------------------------------------------------
# Health check
# ---------------------------------------------------------------------------

# Bound on `harbormaster healthcheck`, the command the container HEALTHCHECK
# runs. Keep it well below the runtime's own health-check timeout, or the
# runtime kills the probe and reports a failure regardless of the real state.
# The probe's URL is derived from HARBORMASTER_HTTP_ADDR; there is nothing to
# configure separately.
HARBORMASTER_HEALTHCHECK_TIMEOUT=3s

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# SQLite database file. The parent directory is created at startup if missing.
HARBORMASTER_DB_PATH=./data/harbormaster.db

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# One of: debug, info, warn, error
HARBORMASTER_LOG_LEVEL=info

# One of: json, text
HARBORMASTER_LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Docker Compose deployment (deployments/compose.yaml)
# ---------------------------------------------------------------------------
# These configure the deployment, not the application, and are read only by
# Compose.

# Image to run. Pin a digest for reproducible deployments:
#   HARBORMASTER_IMAGE=ghcr.io/aznyi/harbormaster@sha256
# `latest` is a moving tag and is not immutable.
HARBORMASTER_IMAGE=ghcr.io/aznyi/harbormaster
HARBORMASTER_TAG=latest

# Host interface and port to publish on. Loopback by default: HarborMaster is
# unauthenticated and fronts a privileged socket. Change this only behind an
# authenticating reverse proxy.
HARBORMASTER_BIND=127.0.0.1
HARBORMASTER_PORT=8080

# The container runs as UID 65532, which needs the host's docker group to read
# the socket. Read the number off the socket rather than guessing -- it varies
# by distribution:
#   stat -c '%g' /var/run/docker.sock
HARBORMASTER_DOCKER_GID=999
