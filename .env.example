# HarborMaster configuration.
#
# Copy to `.env` and adjust. Every value below is a DEFAULT, not a secret --
# HarborMaster never logs environment-variable values, and no credential is
# read from this file today.

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------

# Listen address. Defaults to loopback so a bare binary is never exposed to the
# network by accident. The container image overrides this to 0.0.0.0:8080
# because it is already isolated by the container network namespace.
HARBORMASTER_HTTP_ADDR=127.0.0.1:8080

# Maximum accepted request body, in bytes. Requests above this are rejected
# with 413 before any handler runs.
HARBORMASTER_MAX_REQUEST_BYTES=1048576

# Server timeouts (Go duration syntax: 15s, 1m, 500ms).
HARBORMASTER_READ_HEADER_TIMEOUT=5s
HARBORMASTER_READ_TIMEOUT=15s
HARBORMASTER_WRITE_TIMEOUT=30s
HARBORMASTER_IDLE_TIMEOUT=60s

# Grace period after SIGINT/SIGTERM. ONE budget, covering both the HTTP drain
# and the background services (inventory sweep, event engine, retention): the
# orchestrator counts down a single deadline for the whole process, so the two
# must not each help themselves to their own.
#
# Work already in flight gets this long to finish its transaction rather than
# being cancelled outright, and is then cancelled. Past the bound HarborMaster
# says what it is abandoning and closes the database anyway -- an abandoned
# transaction is rolled back and recoverable; an unbounded hang is not.
HARBORMASTER_SHUTDOWN_TIMEOUT=15s

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------

# Docker Engine endpoint. Treat this socket as a privileged interface: anything
# that can talk to it can control the host's containers. Mount it read-only.
# Windows hosts: npipe:////./pipe/docker_engine
HARBORMASTER_DOCKER_HOST=unix:///var/run/docker.sock

# Per-call timeout for Docker Engine requests.
HARBORMASTER_DOCKER_TIMEOUT=10s

# ---------------------------------------------------------------------------
# Inventory
# ---------------------------------------------------------------------------

# Turn the read-only inventory engine on or off. When false, no refresh runs
# and the API serves whatever was last stored.
HARBORMASTER_INVENTORY_ENABLED=true

# Collect an inventory once as soon as the server is up.
HARBORMASTER_INVENTORY_REFRESH_ON_STARTUP=true

# Periodic refresh interval. Set to 0 to disable periodic refresh and drive it
# manually from the UI or POST /api/v1/inventory/refresh. Non-zero values below
# 5s are rejected: this reads a privileged socket, and hammering it is not a
# configuration anyone wants by accident.
#
# NOTE: this governs the periodic sweep only while the event engine is DISABLED.
# With the engine on, HARBORMASTER_EVENTS_RECONCILE_INTERVAL takes over and this
# ticker is suppressed, so there is never more than one full-refresh timer.
# Startup and manual refreshes are unaffected either way.
HARBORMASTER_INVENTORY_REFRESH_INTERVAL=60s

# Concurrent container inspections. The Docker socket is a single daemon, so
# more is not automatically faster; this bounds the load HarborMaster puts on
# it. Must be between 1 and 64.
HARBORMASTER_INVENTORY_WORKERS=8

# How long a container that has disappeared is kept in the inventory before
# being purged. Absent containers are retained rather than deleted so their
# history survives. Set to 0 to keep them forever.
HARBORMASTER_INVENTORY_ABSENT_RETENTION=168h

# Environment-variable and log-option NAME fragments treated as secret-bearing.
# Matching is case-insensitive and by substring, so AUTH also masks AUTHOR --
# over-masking is the intended bias.
#
# Setting this REPLACES the built-in list rather than extending it. To add a
# pattern, repeat the defaults and append yours.
HARBORMASTER_INVENTORY_MASK_PATTERNS=PASSWORD,PASSWD,SECRET,TOKEN,API_KEY,APIKEY,PRIVATE_KEY,CREDENTIAL,AUTH

# ---------------------------------------------------------------------------
# Docker event engine
# ---------------------------------------------------------------------------
# HarborMaster subscribes to the Docker daemon's event stream and uses events as
# HINTS that inventory may have changed. It never writes container state from an
# event: it re-inspects the resource through the same pipeline a full refresh
# uses. Docker inspection and HarborMaster's own records stay authoritative.

# Turn the event engine on or off. When false nothing subscribes, the SSE
# endpoint reports the feature disabled, and periodic inventory refresh carries
# the inventory alone. That is a supported mode, not a degraded one.
HARBORMASTER_EVENTS_ENABLED=true

# --- Reconnection -----------------------------------------------------------
# Backoff after a dropped stream: the delay starts at the initial value,
# multiplies after each consecutive failure, and is capped at the maximum.
# Jitter of 50-100% is applied on top, so several HarborMasters that lost the
# same daemon do not reconnect in lockstep. A connection that stays up for the
# maximum delay resets the backoff.
HARBORMASTER_EVENTS_RECONNECT_INITIAL_DELAY=1s
HARBORMASTER_EVENTS_RECONNECT_MAX_DELAY=60s
HARBORMASTER_EVENTS_RECONNECT_MULTIPLIER=2.0

# --- Processing -------------------------------------------------------------
# The in-process queue between the stream reader and the event processor. The
# reader never blocks on it: a full queue means the event is dropped, counted,
# and a full reconciliation is requested, because a blocked reader would stall
# the whole stream silently.
HARBORMASTER_EVENTS_BUFFER_SIZE=1024

# Events are persisted in batches: a `compose up` burst costs one commit rather
# than sixty. A partial batch waits at most the flush interval.
HARBORMASTER_EVENTS_BATCH_SIZE=64
HARBORMASTER_EVENTS_BATCH_FLUSH_INTERVAL=500ms

# How long an event fingerprint is remembered, so a duplicate delivery (common
# after a reconnect that overlapped) does not trigger duplicate refresh work. A
# genuinely repeated event at a different Docker timestamp has a different
# fingerprint and is NOT suppressed.
HARBORMASTER_EVENTS_DEDUP_WINDOW=10s

# One lifecycle transition emits a burst: `docker restart` produces kill, die,
# stop, start, and usually a health_status within a second. This window
# coalesces them into a single refresh per resource.
HARBORMASTER_EVENTS_REFRESH_DEBOUNCE=750ms

# --- Reconciliation ---------------------------------------------------------
# The periodic FULL inventory sweep, and the safety net for everything the event
# stream missed. Docker drops events while nothing is listening and replays
# nothing across a daemon restart, so this stays on even when events flow
# perfectly.
#
# IMPORTANT: exactly one component owns the periodic full sweep. While the event
# engine is enabled it owns it at THIS interval, and
# HARBORMASTER_INVENTORY_REFRESH_INTERVAL is suppressed. Disable the event
# engine and the inventory's own interval takes over again, unchanged. Two
# independent full-refresh timers would double the load on a privileged socket.
HARBORMASTER_EVENTS_RECONCILE_INTERVAL=15m

# --- Retention --------------------------------------------------------------
# Event history is observational and unbounded without these. Set either to 0 to
# disable that dimension; both 0 keeps everything forever. Pruning runs in
# bounded batches and touches ONLY the event table -- it can never remove
# current inventory.
HARBORMASTER_EVENTS_RETENTION_AGE=168h
HARBORMASTER_EVENTS_RETENTION_COUNT=50000
HARBORMASTER_EVENTS_PRUNE_INTERVAL=1h

# --- Live stream (Server-Sent Events) ---------------------------------------
# GET /api/v1/events/stream is UNAUTHENTICATED like the rest of the API, so it
# carries only already-redacted event data and no raw Docker payload.

# Concurrent SSE clients. Each costs a buffered channel and a held connection,
# so the cap is what stops anything able to reach the port from pinning both.
# Over the limit the endpoint returns 503 with Retry-After.
HARBORMASTER_EVENTS_STREAM_MAX_SUBSCRIBERS=16

# Per-subscriber queue. A client that stops reading has events dropped for it
# alone; it never blocks event processing for anyone else.
HARBORMASTER_EVENTS_STREAM_BUFFER_SIZE=128

# How many stored events a Last-Event-ID reconnect replays. A client that fell
# further behind gets a truncation notice and should reload the paginated
# history instead of expecting the stream to catch it up.
HARBORMASTER_EVENTS_STREAM_REPLAY_LIMIT=200

# Comment-frame interval that keeps an idle stream alive through proxies.
HARBORMASTER_EVENTS_STREAM_HEARTBEAT=20s

# ---------------------------------------------------------------------------
# Health check
# ---------------------------------------------------------------------------

# Bound on `harbormaster healthcheck`, the command the container HEALTHCHECK
# runs. Keep it well below the runtime's own health-check timeout, or the
# runtime kills the probe and reports a failure regardless of the real state.
# The probe's URL is derived from HARBORMASTER_HTTP_ADDR; there is nothing to
# configure separately.
HARBORMASTER_HEALTHCHECK_TIMEOUT=3s

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# SQLite database file. The parent directory is created at startup if missing,
# with mode 0750 -- the database describes container configuration and secret
# digests and must not be world readable.
HARBORMASTER_DB_PATH=./data/harbormaster.db

# --- Reliability ------------------------------------------------------------
# See docs/engineering/reliability.md for the recovery runbook.

# How long a statement waits for another PROCESS's write lock before failing.
# Within HarborMaster the connection pool already serialises writers, so this
# governs contention with a second instance, a backup tool, or an operator with
# a sqlite3 shell open on the same file. Must be between 100ms and 5m; there is
# deliberately no "0", because "do not wait at all" is a support case waiting
# to happen.
HARBORMASTER_DB_BUSY_TIMEOUT=5s

# Integrity validation performed at startup, BEFORE any migration runs.
#
#   off    no check. Use only if you validate out of band.
#   quick  PRAGMA quick_check. The default: it catches the damage that actually
#          happens (malformed headers, truncated files, broken page links,
#          corrupt B-trees) without reading every index.
#   full   PRAGMA integrity_check plus a foreign key check. Reads every page.
#          Correct for a backup; expensive on a startup path.
#
# DETECTED DAMAGE REFUSES STARTUP. That is deliberate: continuing to write
# history over a malformed image shortens the window in which a backup still
# predates the damage. Setting this to `off` does NOT make a damaged database
# openable -- SQLite refuses a malformed image itself.
#
# An unrecognised value is a startup ERROR, not a silent fallback to off. A
# typo must never disable a safety check.
HARBORMASTER_DB_INTEGRITY_CHECK=quick

# Bound on that check. Past it the result is reported as INCOMPLETE and startup
# continues: an incomplete check establishes nothing, and turning a slow disk
# into an outage is worse than a late diagnosis. Run `harbormaster diagnose`
# when the host is quieter to get a verdict.
HARBORMASTER_DB_INTEGRITY_TIMEOUT=30s

# Refuse to start when write-ahead logging could not be enabled.
#
# Off by default. SQLite falls back to a rollback journal silently on a
# filesystem that cannot support WAL's shared-memory index -- several network
# filesystems and some container volume drivers. That is slower and gives
# readers less concurrency, but it is CORRECT, so refusing to run would be a
# harsh default. HarborMaster warns instead. Turn this on if you depend on
# WAL's crash-recovery profile and would rather fail loudly than run in a mode
# you did not choose.
HARBORMASTER_DB_REQUIRE_WAL=false

# ---------------------------------------------------------------------------
# Configuration snapshots
# ---------------------------------------------------------------------------
# A snapshot is an immutable record of a container's configuration, written to
# HarborMaster's own database. Capture READS Docker and never changes it, and
# there is no restore: snapshots are informational, and prepare for later
# update and rollback work.

# Turns capture and the snapshot endpoints on or off.
HARBORMASTER_SNAPSHOTS_ENABLED=true

# --- Secret digests -------------------------------------------------------
# Sensitive values are NEVER stored. Each one contributes a keyed HMAC-SHA-256
# digest instead, which answers exactly one question -- did this value change
# between two snapshots -- and no others.
#
# PREFERRED: point at a file. This is how Docker Secrets and Kubernetes secret
# volumes present material, and it keeps the key out of the process
# environment, which is readable through /proc/<pid>/environ and is routinely
# captured by process inspectors and crash reporters.
#
# The file must be a regular file (not a symlink) containing exactly 32 bytes
# hex- or base64-encoded, with mode 0600. HarborMaster refuses to start if it
# is malformed, and NEVER silently regenerates a key that has gone missing:
# a fresh key would make every historical digest compare unequal, which reads
# as "every secret in every container changed at once".
#
# HARBORMASTER_SNAPSHOT_HMAC_KEY_FILE=/run/secrets/harbormaster_snapshot_hmac

# Alternative: supply the key directly, hex or base64. Works, but see above.
# HARBORMASTER_SNAPSHOT_HMAC_KEY=

# With neither set, a key is generated once at <data dir>/snapshot-hmac.key
# with mode 0600. A standalone convenience, not the recommended production
# path: back it up, or historical digests become uncomparable.

# --- Secret classification ------------------------------------------------
# Classification matches on the variable NAME, never the value. Scanning
# values produces false positives on any long random string and false
# negatives on short passwords.
#
# default        classify by name pattern (see below)
# all-sensitive  treat EVERY variable as sensitive regardless of name
#
# Use all-sensitive when you cannot enumerate your variables. It is the only
# setting that closes the gap where a credential hides under an innocuous name
# such as ENDPOINT or CONFIG. It costs diff readability for ordinary
# variables.
HARBORMASTER_MASK_MODE=default

# Additional name fragments, merged WITH the defaults. Additive, so this
# cannot reduce protection.
# HARBORMASTER_MASK_PATTERNS_EXTRA=TENANT,REALM

# Name fragments that REPLACE the defaults entirely. The one masking setting
# that can reduce protection, so it logs a warning at startup. Mutually
# exclusive with _EXTRA above.
# HARBORMASTER_MASK_PATTERNS_OVERRIDE=

# --- Restore readiness ----------------------------------------------------
# Most readiness checks answer from HarborMaster's inventory rather than from
# the daemon, so a verdict is only as trustworthy as the inventory is recent.
# Beyond this age, readiness degrades to at most "warning" rather than
# claiming "ready" on a stale reading. Evaluation never triggers a refresh:
# a read endpoint that can drive privileged socket traffic is a DoS amplifier.
HARBORMASTER_SNAPSHOT_READINESS_MAX_INVENTORY_AGE=15m

# --- Retention ------------------------------------------------------------
# Maximum snapshots kept PER CONTAINER, and maximum age. Zero on either
# disables that dimension; both zero keeps everything, which is valid but
# unbounded. The newest snapshot of a container is never pruned under any
# policy -- it is the restore baseline.
HARBORMASTER_SNAPSHOT_RETENTION_COUNT=50
HARBORMASTER_SNAPSHOT_RETENTION_AGE=2160h

# How often retention runs, and how many rows one transaction deletes.
# Bounded batches keep a large backlog from holding the single SQLite writer.
HARBORMASTER_SNAPSHOT_PRUNE_INTERVAL=1h
HARBORMASTER_SNAPSHOT_PRUNE_BATCH=200

# --- Diff limits ----------------------------------------------------------
# A diff decodes two documents and compares two configuration sets, and an
# unauthenticated caller can ask for one repeatedly. Excess concurrent
# requests are refused with 429 rather than queued: a queue turns a load spike
# into unbounded memory and latency.
HARBORMASTER_SNAPSHOT_MAX_CONCURRENT_DIFFS=4
HARBORMASTER_SNAPSHOT_DIFF_TIMEOUT=5s
HARBORMASTER_SNAPSHOT_MAX_DIFF_ENTRIES=1000
HARBORMASTER_SNAPSHOT_MAX_GROUP_ENTRIES=5000

# --- Write-endpoint limits ------------------------------------------------
# Bounds the POST endpoints (snapshot capture and inventory refresh). The rate
# limit is per-process, not per-client: HarborMaster is unauthenticated, so
# there is no trustworthy client identity to key on, and a per-IP bucket would
# be trivially evaded while implying a precision it does not have.
HARBORMASTER_WRITE_RATE_LIMIT=6
HARBORMASTER_WRITE_RATE_BURST=3

# Maximum length of the operator-supplied capture reason.
HARBORMASTER_SNAPSHOT_MAX_REASON_BYTES=500

# ---------------------------------------------------------------------------
# Configuration drift detection
# ---------------------------------------------------------------------------
# Drift is the difference between a container's BASELINE snapshot -- its most
# recent capture, the one retention never prunes -- and its configuration now.
#
# Detection reuses the same comparison engine as the snapshot diff endpoint, so
# drift and a manual comparison can never disagree. It reads HarborMaster's own
# inventory and its own snapshots; it never calls Docker.
#
# HarborMaster REPORTS drift and cannot correct it. There is no remediation,
# rollback, or apply capability anywhere behind these settings.

# Turn detection on or off. When false nothing is evaluated and the endpoints
# report the feature disabled. Records already collected stay readable.
HARBORMASTER_DRIFT_ENABLED=true

# --- When evaluation runs ---------------------------------------------------
# Evaluate a container after the event engine's refresh for it COMMITS. The
# ordering matters: evaluating on the raw event would compare the baseline
# against inventory that is one generation stale, every time.
HARBORMASTER_DRIFT_EVALUATE_ON_EVENTS=true

# One lifecycle transition emits a burst, so requests for the same container
# collapse into one evaluation. The first request's deadline stands rather than
# being extended, so a container emitting health_status every few seconds is
# still evaluated at a steady cadence instead of never.
HARBORMASTER_DRIFT_EVALUATION_DEBOUNCE=5s

# The coalescing queue's cap. Past it the engine stops tracking containers
# individually and escalates to a full sweep, which covers all of them and
# costs less than the tracking. Must be between 1 and 4096.
HARBORMASTER_DRIFT_MAX_PENDING_EVALUATIONS=256

# The periodic full sweep, and the safety net for whatever the event stream
# missed. Set to 0 to disable it and rely on events alone. This is the most
# expensive periodic job HarborMaster runs: it decodes one snapshot document
# per container.
HARBORMASTER_DRIFT_SWEEP_INTERVAL=30m

# Evaluate the estate once at boot, so a HarborMaster that was down while
# containers changed reports drift without waiting for the first interval.
HARBORMASTER_DRIFT_SWEEP_ON_STARTUP=true

# --- Bounds -----------------------------------------------------------------
# Bound on one container's comparison.
HARBORMASTER_DRIFT_EVALUATION_TIMEOUT=10s

# How many differences one evaluation may record. Past it the comparison is
# marked INCOMPLETE rather than truncated silently -- and an incomplete
# evaluation resolves nothing, because it never established that the fields it
# did not reach still match. Must be between 1 and 5000.
HARBORMASTER_DRIFT_MAX_RECORDS_PER_CONTAINER=500

# Maximum length of an operator's note on a status change.
HARBORMASTER_DRIFT_MAX_NOTE_BYTES=500

# --- Retention --------------------------------------------------------------
# How long a RESOLVED record is kept. Open records are never pruned: an
# unreviewed difference does not become less true with age. Set to 0 to keep
# resolved history forever, which is valid but unbounded.
HARBORMASTER_DRIFT_RETENTION_AGE=720h
HARBORMASTER_DRIFT_PRUNE_INTERVAL=6h

# ---------------------------------------------------------------------------
# Policy engine
# ---------------------------------------------------------------------------
#
# A policy is an administrator-defined rule that a container's configuration is
# CHECKED AGAINST. It is never applied, enforced, or pushed to the daemon: the
# engine reads the inventory HarborMaster has already persisted, applies rules
# in memory, and writes the failures to its own tables.
#
# Policy is not drift. Drift measures change from a baseline; a policy measures
# compliance with a rule. A container can drift into a still-compliant
# configuration, and one that has never moved can be non-compliant from the day
# it was created because the rule arrived later.
#
# THE BOUNDS BELOW ARE SECURITY CONTROLS, NOT TUNING KNOBS. Policy definitions
# arrive through an unauthenticated API, so the number of policies, the rules in
# each, and the values in each rule all have to be capped -- otherwise a caller
# could make every compliance pass arbitrarily expensive.

# Turn the engine on or off. When false nothing is evaluated and the endpoints
# report the feature disabled. Definitions and violations already stored stay in
# the database.
HARBORMASTER_POLICY_ENABLED=true

# --- When evaluation runs ---------------------------------------------------
# A full pass runs after every SUCCESSFUL INVENTORY REFRESH regardless of the
# settings here -- that is the authoritative trigger, and it covers the startup
# refresh, the periodic one, the manual one, and the event engine's
# reconciliation, because all four commit through the same path.
#
# This setting adds a per-container pass after a TARGETED refresh commits, which
# keeps the dashboard current between full refreshes.
HARBORMASTER_POLICY_EVALUATE_ON_EVENTS=true

# One lifecycle transition emits a burst, so requests for the same container
# collapse into one evaluation.
HARBORMASTER_POLICY_EVALUATION_DEBOUNCE=5s

# The coalescing queue's cap. Past it the engine stops tracking containers
# individually and escalates to a full sweep, which covers all of them and costs
# less than the tracking. Must be between 1 and 4096.
HARBORMASTER_POLICY_MAX_PENDING_EVALUATIONS=256

# The periodic full pass, and the safety net for anything the refresh
# notifications missed. Set to 0 to disable it. Shorter than the drift sweep
# because a compliance pass is much cheaper: it reads container rows the
# inventory already holds and applies rules in memory, where drift decodes one
# snapshot document per container.
HARBORMASTER_POLICY_SWEEP_INTERVAL=15m

# Evaluate the estate once at boot.
HARBORMASTER_POLICY_SWEEP_ON_STARTUP=true

# --- Bounds -----------------------------------------------------------------
# Bound on one container's pass.
HARBORMASTER_POLICY_EVALUATION_TIMEOUT=10s

# How many active policies one pass may load. Past it the remainder are not
# evaluated and a warning is logged. Must be between 1 and 2000.
HARBORMASTER_POLICY_MAX_POLICIES=200

# How many failures one container's pass may record. Past it the pass is marked
# INCOMPLETE rather than truncated silently -- and an incomplete pass resolves
# nothing, because it never established that the rules it did not apply now
# pass. Must be between 1 and 5000.
HARBORMASTER_POLICY_MAX_VIOLATIONS_PER_CONTAINER=500

# What the API accepts in one policy definition, and therefore what one
# evaluation can be asked to cost. A container's per-policy cost is bounded by
# MAX_RULES_PER_POLICY * MAX_VALUES_PER_RULE pattern matches, each of which is
# itself bounded in pattern and subject length.
HARBORMASTER_POLICY_MAX_RULES_PER_POLICY=32
HARBORMASTER_POLICY_MAX_VALUES_PER_RULE=32
HARBORMASTER_POLICY_MAX_NAME_BYTES=120
HARBORMASTER_POLICY_MAX_DESCRIPTION_BYTES=1000

# Maximum length of an operator's note on a status change.
HARBORMASTER_POLICY_MAX_NOTE_BYTES=500

# --- Write rate limit -------------------------------------------------------
# The policy write endpoints get their OWN budget, separate from
# HARBORMASTER_WRITE_RATE_LIMIT and deliberately more permissive.
#
# A rate limit should be proportional to what the request costs. A snapshot
# capture or an inventory refresh drives a Docker sweep; a policy write is one
# small transaction on HarborMaster's own table. Sharing one bucket would mean
# either throttling the cheap operation absurdly -- an operator building a
# five-rule policy set would hit 429 -- or under-protecting the expensive one.
#
# POST /policy/evaluate shares this bucket: the request is cheap, and what
# bounds the work it schedules is the coalescing queue behind it.
#
# Per process, not per client: HarborMaster is unauthenticated, so there is no
# trustworthy client identity to key a bucket on.
HARBORMASTER_POLICY_WRITE_RATE_LIMIT=60
HARBORMASTER_POLICY_WRITE_RATE_BURST=20

# --- Retention --------------------------------------------------------------
# How long a RESOLVED violation is kept. Open violations are never pruned: an
# unreviewed failure does not become less true with age. Set to 0 to keep
# resolved history forever, which is valid but unbounded.
#
# Longer than the drift default: compliance history is the thing an audit asks
# for, and "what were we failing last quarter" needs a quarter of history.
HARBORMASTER_POLICY_RETENTION_AGE=2160h
HARBORMASTER_POLICY_PRUNE_INTERVAL=6h

# ---------------------------------------------------------------------------
# Image intelligence and update discovery
# ---------------------------------------------------------------------------
#
# THIS SECTION GOVERNS HARBORMASTER'S ONLY OUTBOUND NETWORK EGRESS.
#
# Everything else in HarborMaster talks to a local Docker socket and a local
# SQLite file. This feature makes anonymous HTTPS GETs to registry manifest and
# tag-listing endpoints to discover whether a newer image is published.
#
# It READS. It does not pull, push, delete, prune, tag, or recreate anything,
# and there is no setting below that could make it. An update is reported;
# applying one is your job with your own tooling.
#
# --- What you cannot configure here, and why ---------------------------------
#
# THERE IS NO REGISTRY HOST SETTING. Destinations are derived only from image
# references that containers in your inventory actually declare. That is the
# core of the SSRF defence: no configuration value, API parameter, or database
# column supplies a host, so there is no way to point HarborMaster at an
# arbitrary address.
#
# THERE IS NO CREDENTIAL SETTING. Every lookup is anonymous. HarborMaster reads
# no Docker config, no keychain, and no credential helper. A private repository
# reports "unauthorized" -- an honest statement that the answer is unavailable,
# rather than a reason for HarborMaster to start handling your registry
# passwords.
#
# THERE IS NO INSECURE-REGISTRY SETTING. HTTPS with certificate verification,
# always. A registry reachable only over plaintext, on a non-default port, at an
# IP address, or at a single-label internal name is reported as "unsupported"
# and never contacted.
#
# --- Turning it off ----------------------------------------------------------
# When false, NO OUTBOUND REQUEST IS EVER MADE. This is the setting an air-gapped
# or egress-restricted deployment wants. Metadata already collected stays in the
# database and remains readable.
HARBORMASTER_IMAGE_INTEL_ENABLED=true

# Collect once at boot, so a HarborMaster that was down while images changed
# reports updates without waiting for the first interval.
HARBORMASTER_IMAGE_INTEL_COLLECT_ON_STARTUP=true

# --- Cadence -----------------------------------------------------------------
# How long a successful answer stays fresh. Publishers do not ship several times
# an hour, and a 6-hour cadence over a thousand images is a handful of requests
# a minute.
HARBORMASTER_IMAGE_INTEL_REFRESH_INTERVAL=6h

# How often the due set is drained. Much shorter than the refresh interval
# because each pass processes a bounded BATCH -- the pair is what spreads a large
# estate over time instead of bursting at one registry. Set to 0 to collect only
# when asked through POST /api/v1/images/refresh.
HARBORMASTER_IMAGE_INTEL_COLLECT_INTERVAL=5m

# --- Politeness bounds -------------------------------------------------------
# These are as much about staying welcome at somebody else's registry as about
# bounding HarborMaster. A registry that decides a client is abusive rate-limits
# every client sharing your egress address, not just this one.

# Simultaneous registry requests across the whole process. Must be 1-16.
HARBORMASTER_IMAGE_INTEL_MAX_CONCURRENT_REQUESTS=4

# How many references one pass looks up. A larger estate is covered over several
# passes rather than all at once. Must be 1-500.
HARBORMASTER_IMAGE_INTEL_MAX_REFERENCES_PER_PASS=50

# How many distinct references are tracked at all. Must be 1-100000.
HARBORMASTER_IMAGE_INTEL_MAX_TRACKED_REFERENCES=10000

# How many pages of a tag listing to read. Past it the result is reported as
# INCOMPLETE rather than as "no update available" -- a listing that stopped at
# its budget has not established that no newer tag exists. Must be 1-50.
HARBORMASTER_IMAGE_INTEL_MAX_TAG_PAGES=5

# --- Per-request bounds ------------------------------------------------------
# One registry request, and how many times a TRANSIENT failure is retried within
# it. A 404, a 401, or a rate limit is never retried: the first two would return
# the same answer, and retrying the third is precisely what the registry asked
# HarborMaster not to do.
HARBORMASTER_IMAGE_INTEL_REQUEST_TIMEOUT=15s
HARBORMASTER_IMAGE_INTEL_MAX_ATTEMPTS=3
HARBORMASTER_IMAGE_INTEL_RETRY_BACKOFF=500ms

# --- Failure backoff ---------------------------------------------------------
# How long before a failing reference or registry is tried again, doubling each
# time up to the cap. Jittered, so a registry coming back after an outage is not
# met with every reference retrying in the same instant.
#
# A registry's own Retry-After takes precedence when it sends one, bounded at
# six hours so a hostile or misconfigured value delays a check rather than
# cancelling it.
HARBORMASTER_IMAGE_INTEL_FAILURE_BACKOFF=15m
HARBORMASTER_IMAGE_INTEL_MAX_FAILURE_BACKOFF=24h

# How often a reference that cannot be looked up is reconsidered. Long, because
# the answer almost never changes -- but not never, since a private repository
# can become public and an image can be published later.
HARBORMASTER_IMAGE_INTEL_UNSUPPORTED_INTERVAL=24h

# --- Retention ---------------------------------------------------------------
# How long an observed CHANGE is kept. Only actual changes are recorded, so this
# table grows with the rate the world changes rather than with the refresh
# interval. Set to 0 to keep history forever, which is valid but unbounded.
HARBORMASTER_IMAGE_INTEL_HISTORY_RETENTION=2160h
HARBORMASTER_IMAGE_INTEL_PRUNE_INTERVAL=6h

# ---------------------------------------------------------------------------
# Change planning and risk analysis
# ---------------------------------------------------------------------------
# HarborMaster assesses each PROPOSED image change: how risky it looks, why, and
# what an operator should do about it.
#
# NOTHING APPLIES A PLAN. HarborMaster cannot pull an image, recreate a
# container, or roll one back, and planning adds no such capability -- the
# planner reads six tables it already populated and writes one. A plan is
# analysis; acting on it is your job with your own tooling.
#
# It makes NO NETWORK REQUEST and touches NO DOCKER SOCKET. Every input comes
# from data HarborMaster has already persisted, which is what makes a plan
# reproducible from the database alone.
#
# The risk model is DETERMINISTIC: a fixed set of rules over integer scores,
# with no clock, randomness, or I/O inside it. The same inputs produce the same
# verdict, byte for byte. Nothing about it is learned or probabilistic.
#
# --- Turning it off ----------------------------------------------------------
# When false, nothing is generated and the plan endpoints report the feature
# disabled. Plans already stored stay in the database and remain readable.
HARBORMASTER_PLANNER_ENABLED=true

# Generate once at boot, so a HarborMaster that was down while the estate
# changed has current plans without waiting for the first interval.
HARBORMASTER_PLANNER_GENERATE_ON_STARTUP=true

# --- Cadence -----------------------------------------------------------------
# The periodic pass. A pass also runs after every successful inventory refresh
# and whenever POST /plans/generate is called.
#
# Short, because a pass over an unchanged estate WRITES NOTHING: every
# assessment is fingerprinted over exactly the values it read, so the common
# case costs a handful of grouped queries and no rows at all.
#
# Set to 0 to disable the periodic pass, leaving refresh and request as the
# triggers. Minimum 1m when non-zero.
HARBORMASTER_PLANNER_INTERVAL=15m

# --- Bounds ------------------------------------------------------------------
# How many containers one batch assesses. Each batch costs a fixed number of
# grouped queries whatever its size, so this trades peak memory against query
# count rather than against round trips.
HARBORMASTER_PLANNER_BATCH_SIZE=500

# Caps a whole pass, so a pathologically large inventory produces a bounded
# amount of work.
HARBORMASTER_PLANNER_MAX_CONTAINERS=20000

# Bounds one pass. A pass cannot outlive its own schedule.
HARBORMASTER_PLANNER_GENERATION_TIMEOUT=5m

# --- Retention ---------------------------------------------------------------
# How long a SUPERSEDED plan is kept. The current plan for a container is never
# pruned, whatever its age: it is the standing assessment, and removing it would
# leave the container looking unplanned rather than unchanged.
#
# Set to 0 to keep superseded plans forever, which is valid but unbounded.
HARBORMASTER_PLANNER_RETENTION_AGE=2160h
HARBORMASTER_PLANNER_PRUNE_INTERVAL=6h

# ---------------------------------------------------------------------------
# Safe image acquisition
# ---------------------------------------------------------------------------
# THIS IS THE ONE FEATURE THAT CAN CHANGE YOUR DOCKER HOST.
#
# Everything else HarborMaster does reads: a local Docker socket, a local SQLite
# file, and -- for image intelligence -- a public registry. This downloads an
# approved image into the daemon's local image store, which is a write.
#
# --- What it still cannot do -------------------------------------------------
# IT DOES NOT UPDATE CONTAINERS. A container keeps running the image it was
# created from; an acquired image is another entry in the local store beside it.
# There is no setting here, and no endpoint anywhere, that stops, starts,
# recreates, or reconfigures a container, or that deletes or prunes an image.
# HarborMaster's entire Docker write surface is a single method that pulls one
# digest-pinned image, and an architecture test fails the build if a second
# appears.
#
# Applying an acquired image is your job, with your own tooling.
#
# --- The safety model --------------------------------------------------------
# An acquisition must be requested by a person, must name a CHANGE PLAN that
# currently recommends the change, and is revalidated immediately before the
# download -- so a tag that moved, a plan that was superseded, or a container
# that disappeared between approval and transfer all stop it. The image is then
# re-inspected and its digest and platform compared against what was approved;
# a mismatch is a failure, not a success with a caveat.
#
# Nothing here happens on a schedule. There is no automatic pull.
#
# --- Turning it on -----------------------------------------------------------
# OFF BY DEFAULT, alone among HarborMaster's features. When false the capability
# is ABSENT rather than merely unused: no acquirer is wired, the endpoints report
# the feature disabled, and the process holds no write access to Docker at all.
HARBORMASTER_ACQUISITION_ENABLED=false

# Refuse an acquisition for a container with no usable configuration snapshot.
#
# Downloading an image puts nothing at risk by itself, so this gate is about
# what you do NEXT: having a recorded configuration to refer back to is the
# difference between a considered change and an irreversible one. Turn it off
# only if you do not capture snapshots.
HARBORMASTER_ACQUISITION_REQUIRE_SNAPSHOT=true

# --- Bounds ------------------------------------------------------------------
# Simultaneous transfers, in total and against any one registry.
#
# The per-registry limit is the one that matters to a third party: anonymous
# rate limits are shared by egress address, so a host that opens several
# transfers at once against a public registry gets everything behind that
# address throttled. It must not exceed the global limit.
HARBORMASTER_ACQUISITION_MAX_CONCURRENT=2
HARBORMASTER_ACQUISITION_MAX_PER_REGISTRY=1

# Bounds one transfer. Generous, because a multi-gigabyte image over a slow link
# is not a fault -- but bounded, because a transfer that never finishes would
# hold a slot forever.
HARBORMASTER_ACQUISITION_PULL_TIMEOUT=30m

# How long a queued request stays valid. Past it the request EXPIRES unstarted:
# the evidence behind the approval has aged, and running it later would be
# acting on a check nobody has repeated.
HARBORMASTER_ACQUISITION_REQUEST_TTL=1h

# How recent a successful registry lookup must be for its digest to be acted on.
# Older evidence does not establish that the digest is still what is being
# served, and the digest is the entire safety property.
HARBORMASTER_ACQUISITION_REGISTRY_FRESHNESS=24h

# Bounds the audit trail for one acquisition. The daemon's progress stream is
# unbounded and registry-influenced, so this is the last of three independent
# bounds on how much of it is persisted.
HARBORMASTER_ACQUISITION_MAX_EVENTS=200

# How often the queue is re-examined for expired requests and for work a limit
# was blocking. 0 disables the periodic sweep, leaving request and completion as
# the triggers.
HARBORMASTER_ACQUISITION_SWEEP_INTERVAL=1m

# --- Retention ---------------------------------------------------------------
# How long a COMPLETED acquisition record is kept. Deliberately long: it is the
# evidence that an image was downloaded, and the most recent record per
# container is never pruned. 0 keeps them forever, which is valid but unbounded.
HARBORMASTER_ACQUISITION_RETENTION_AGE=4320h
HARBORMASTER_ACQUISITION_PRUNE_INTERVAL=6h

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# One of: debug, info, warn, error
HARBORMASTER_LOG_LEVEL=info

# One of: json, text
HARBORMASTER_LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Docker Compose deployment (deployments/compose.yaml)
# ---------------------------------------------------------------------------
# These configure the deployment, not the application, and are read only by
# Compose.

# Image to run. Pin a digest for reproducible deployments:
#   HARBORMASTER_IMAGE=ghcr.io/aznyi/harbormaster@sha256
# `latest` is a moving tag and is not immutable.
HARBORMASTER_IMAGE=ghcr.io/aznyi/harbormaster
HARBORMASTER_TAG=latest

# Host interface and port to publish on. Loopback by default: HarborMaster is
# unauthenticated and fronts a privileged socket. Change this only behind an
# authenticating reverse proxy.
HARBORMASTER_BIND=127.0.0.1
HARBORMASTER_PORT=8080

# The container runs as UID 65532, which needs the host's docker group to read
# the socket. Read the number off the socket rather than guessing -- it varies
# by distribution:
#   stat -c '%g' /var/run/docker.sock
HARBORMASTER_DOCKER_GID=999
